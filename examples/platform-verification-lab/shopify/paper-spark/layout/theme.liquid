<!doctype html>
<html lang="{{ request.locale.iso_code | escape }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ page_title | escape }}{% unless page_title contains shop.name %} – {{ shop.name | escape }}{% endunless %}</title>{% if page_description != blank %}<meta name="description" content="{{ page_description | escape }}">{% endif %}<link rel="canonical" href="{{ canonical_url | escape }}">{{ 'theme.css' | asset_url | stylesheet_tag }}<script src="{{ 'variants.js' | asset_url }}" defer></script>{{ content_for_header }}</head>
<body><a class="skip" href="#main">Skip to content</a><header class="wrap header"><a class="brand" href="{{ routes.root_url }}">{{ shop.name | escape }}</a><nav aria-label="Primary navigation"><a href="{{ routes.all_products_collection_url }}">Shop</a><a href="{{ routes.cart_url }}">Bag ({{ cart.item_count }})</a></nav></header><main id="main" class="wrap">{{ content_for_layout }}</main><footer class="wrap footer"><a href="{{ routes.root_url }}">{{ shop.name | escape }}</a>{% for policy in shop.policies %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endfor %}</footer></body></html>
